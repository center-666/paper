    "main_joint_kernel.tex": {
      "display_math": [
        "\\begin{equation}\n \\begin{aligned}\n \\mathcal K_{h,d}(\\{\\bot\\})&=\\int\\phi_{S'_h}(e)g(e+d)\\,de,\\\\\n \\mathcal K_{h,d}(de)&=\\phi_{S'_h}(e)[1-g(e+d)]\\,de,\\\\\n F_h(t)(dz,d\\xi)&=f_h(z-tv)\\,dz\\,\\mathcal K_{h,-tu_h}(d\\xi).\n \\end{aligned}\n \\label{eq:main-joint-kernel}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n \\|F_h''(t)\\|_{\\rm var}\n &\\le \\|\\partial_v^2 f_h\\|_1\n +4\\sqrt{a_h/\\mathrm e}\\|\\partial_v f_h\\|_1\n +2p_ha_h\\\\\n &\\le B_h<\\infty.\n \\end{aligned}\n \\label{eq:main-kernel-smooth}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n Q_h^\\eta-F_h(0)\n &=\\frac12\\int_0^\\eta(\\eta-t)\n [F_h''(t)+F_h''(-t)]\\,dt,\\\\\n \\|Q_h^\\eta-F_h(0)\\|_{\\rm var}&\\le \\tfrac12B_h\\eta^2.\n \\end{aligned}\n \\label{eq:main-kernel-taylor}\n\\end{equation}"
      ],
      "declarations": [],
      "labels": [
        "eq:main-joint-kernel",
        "eq:main-kernel-smooth",
        "eq:main-kernel-taylor"
      ]
    },
