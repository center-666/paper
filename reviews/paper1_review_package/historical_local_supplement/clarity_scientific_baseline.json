    "record_design.tex": {
      "display_math": [
        "\\begin{equation}\n \\begin{gathered}\n \\Delta_{\\rm last}=0,\\quad J_1=c_*b^2+O(b^4),\\\\\n c_*\\approx0.00049907284045>0.\n \\end{gathered}\n \\label{eq:last-counterexample}\n\\end{equation}"
      ],
      "declarations": [
        "\\begin{proposition}[当拍截止记录的局限]\n\\label{prop:deletion}\n在主定理的任意固定 $n$ 维模型下，若只约束截至目标时刻的完整日志 $H_k$，\n则充分小的 $b>0$ 时仍存在满足峰值约束的因果攻击，使 $H_k$ 与无攻击运行同律，\n同时产生 $\\Theta(b^2)$ 的正损伤。\n\\end{proposition}",
        "\\begin{proposition}[末事件位的标量反例]\n\\label{prop:last-bit}\n取标量模型 $A=1$、$P_0=4/5$、$Q=2$、$R=1/5$、$Z=2$ 及目标时刻 $k=1$。\n充分小的 $b>0$ 下存在满足峰值约束的因果策略，使\n\\begin{equation}\n \\begin{gathered}\n \\Delta_{\\rm last}=0,\\quad J_1=c_*b^2+O(b^4),\\\\\n c_*\\approx0.00049907284045>0.\n \\end{gathered}\n \\label{eq:last-counterexample}\n\\end{equation}\n\\end{proposition}"
      ],
      "labels": [
        "sec:records",
        "prop:deletion",
        "prop:last-bit",
        "eq:last-counterexample"
      ]
    },
    "theory.tex": {
      "display_math": [
        "\\begin{equation}\n x_{t+1}=Ax_t+w_t,\\qquad y_t=x_t+v_t\\in\\R^n.\n \\label{eq:model}\n\\end{equation}",
        "\\begin{equation}\n \\gamma_t=0\\ \\Longleftrightarrow\\ U_t\\le g(y_t-m_t^-),\\quad\n g(z)=\\exp(-z^\\top Zz/2).\n \\label{eq:trigger}\n\\end{equation}",
        "\\begin{equation}\n \\widetilde y_t=y_t+a_t,\\qquad \\|a_t\\|_2\\le b.\n \\label{eq:peak}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n K_i(P)&=P(P+R_i)^{-1},\\\\\n F_i(P)&=P-P(P+R_i)^{-1}P\\\\\n       &=(P^{-1}+R_i^{-1})^{-1},\\quad i\\in\\{0,1\\}.\n \\end{aligned}\n \\label{eq:gains}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n m_t^+&=m_t^-+\\gamma_tK_1(P_t^-)(\\widetilde y_t-m_t^-),\\\\\n P_t^+&=F_{\\gamma_t}(P_t^-),\\\\\n m_{t+1}^-&=Am_t^+,\\quad P_{t+1}^-=AP_t^+A^\\top+Q,\n \\end{aligned}\n \\label{eq:receiver}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n \\mathcal G_t^-&=\\sigma(S,\\gamma_{0:t-1},Y_{0:t-1}^{\\rm true}),\\\\\n \\mathcal G_t^+&=\\mathcal G_t^-\\vee\\sigma(\\gamma_t,Y_t^{\\rm true}).\n \\end{aligned}\n \\label{eq:information}\n\\end{equation}",
        "\\begin{equation}\n J_k(\\pi)=\\E_\\pi\\|x_k-m_k^+\\|_2^2-\n             \\E_0\\|x_k-m_k^+\\|_2^2.\n \\label{eq:damage}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n R_{\\rm full}&=H_{k+1},\\\\\n R_{\\rm bits}&=\\gamma_{0:k+1},\\\\\n R_{\\rm marked}&=(P_k^+,\\gamma_{k+1}).\n \\end{aligned}\n \\label{eq:records}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n \\Delta_j(\\pi)&=\\TV(\\Law_\\pi(R_j),\\Law_0(R_j)),\\\\\n V_j(b,\\varepsilon)&=\\sup_{\\pi:\\,\\|a_t\\|_2\\le b,\\,\\Delta_j(\\pi)\\le\\varepsilon}J_k(\\pi).\n \\end{aligned}\n \\label{eq:value}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n D_t&=(I-K_{\\gamma_t}(P_t^-))d_t-\\gamma_t K_1(P_t^-)a_t,\\\\\n d_{t+1}&=AD_t,\\quad d_0=0,\\\\\n J_k(\\pi)&=\\E_\\pi\\|D_k\\|_2^2+\n \\E_\\pi\\operatorname{tr}P_k^+-\\E_0\\operatorname{tr}P_k^+.\n \\end{aligned}\n \\label{eq:decomposition}\n\\end{equation}",
        "\\begin{equation}\n c\\min\\{b^2,\\varepsilon\\}\\le V_j(b,\\varepsilon)\n \\le C\\min\\{b^2,\\varepsilon\\}.\n \\label{eq:main}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n \\alpha_t&=\\max_{P,i}\\|I-K_i(P)\\|_2,\\quad\n \\beta_t=\\max_P\\|K_1(P)\\|_2,\\\\\n r_0&=\\beta_0,\\quad r_t=\\alpha_t\\|A\\|_2r_{t-1}+\\beta_t,\\\\\n \\ell_0&=0,\\quad \\ell_t=\\|A\\|_2r_{t-1}\\quad(t\\ge1).\n \\end{aligned}\n \\label{eq:radii}\n\\end{equation}",
        "\\begin{equation}\n \\Pr_\\pi(\\gamma_t=0\\mid h)\n =s_h\\E_\\pi[e^{-d_t^\\top W_hd_t/2}\\mid h].\n \\label{eq:prefix-silence}\n\\end{equation}",
        "\\begin{equation}\n \\TV(\\Law_\\pi(\\gamma_{0:k}),\\Law_0(\\gamma_{0:k}))\n \\le\\frac{\\|Z\\|_2b^2}{2}\\sum_{t=1}^k\\ell_t^2.\n \\label{eq:prefix-tv}\n\\end{equation}",
        "\\begin{equation}\n J_k\\le C_{\\rm peak}b^2,\\qquad\n C_{\\rm peak}=r_k^2+\\frac{\\Omega_k\\|Z\\|_2}{2}\\sum_{t=1}^k\\ell_t^2.\n \\label{eq:peak-bound}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n \\Sigma(P)&=APA^\\top+Q+R,\\\\\n s(P)&=\\det(I+Z^{1/2}\\Sigma(P)Z^{1/2})^{-1/2},\\\\\n w(P)&=s(P)^{-1},\\\\\n H(P)&=\\tfrac12 A^\\top[Z^{-1}+\\Sigma(P)]^{-1}A.\n \\end{aligned}\n \\label{eq:witness-functions}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n \\E_\\pi[Y\\mid\\mathcal G_k^+]&=s(P)e^{-D^\\top H(P)D},\\\\\n \\E_0[w(P)Y]&=1,\\quad\n \\E_\\pi[w(P)Y]=\\E_\\pi e^{-D^\\top H(P)D}.\n \\end{aligned}\n \\label{eq:witness}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n h_*&=\\min_{P\\in\\mathcal P_k^+}\\lambda_{\\min}(H(P)),\\quad\n M=\\max_{P\\in\\mathcal P_k^+}w(P),\\\\\n B_*&=r_kb_{\\rm ref},\\quad q=\\frac{1-e^{-h_*B_*^2}}{B_*^2}>0.\n \\end{aligned}\n \\label{eq:witness-constants}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n q\\E_\\pi\\|D\\|_2^2&\\le\\E_0[w(P)Y]-\\E_\\pi[w(P)Y]\\\\\n &\\le M\\Delta_{\\rm marked}(\\pi),\\\\\n J_k(\\pi)&\\le C_{\\rm record}\\Delta_{\\rm marked}(\\pi),\\\\\n C_{\\rm record}&=M/q+\\Omega_k.\n \\end{aligned}\n \\label{eq:record-bound}\n\\end{equation}",
        "\\begin{equation}\n \\kappa=\\bigl[\\max\\{1,\\max_h\\|AK_hv\\|_2\\}\\bigr]^{-1},\\quad \\eta=\\kappa b.\n \\label{eq:kappa}\n\\end{equation}",
        "\\begin{equation}\n J_k=L_v\\eta^2,\\qquad L_v=\\sum_hw_hp_h\\|K_hv\\|_2^2>0.\n \\label{eq:lower-damage}\n\\end{equation}",
        "\\begin{equation}\n \\begin{aligned}\n \\Delta_{\\rm full}&\\le\\varepsilon,\\\\\n J_k&=L_v\\min\\{\\kappa^2b^2,\\varepsilon/C_\\pm\\}.\n \\end{aligned}\n \\label{eq:attainable}\n\\end{equation}"
      ],
      "declarations": [
        "\\begin{lemma}[条件误差分解]\n\\label{lem:gaussian}\n对任意允许策略，$x_t\\mid\\mathcal G_t^\\pm$ 为高斯分布，均值记为 $\\mu_t^\\pm$，\n协方差为 $P_t^\\pm$。令 $d_t=\\mu_t^--m_t^-$、$D_t=\\mu_t^+-m_t^+$，则\n\\begin{equation}\n \\begin{aligned}\n D_t&=(I-K_{\\gamma_t}(P_t^-))d_t-\\gamma_t K_1(P_t^-)a_t,\\\\\n d_{t+1}&=AD_t,\\quad d_0=0,\\\\\n J_k(\\pi)&=\\E_\\pi\\|D_k\\|_2^2+\n \\E_\\pi\\operatorname{tr}P_k^+-\\E_0\\operatorname{tr}P_k^+.\n \\end{aligned}\n \\label{eq:decomposition}\n\\end{equation}\n\\end{lemma}",
        "\\begin{theorem}[任意固定维数下的可达到损伤阶数]\n\\label{thm:main}\n固定式\\eqref{eq:model}--\\eqref{eq:information}的模型、有限 $k$ 及参考峰值\n$b_{\\rm ref}>0$。存在 $0<c\\le C<\\infty$，使所有 $0<b\\le b_{\\rm ref}$、\n$0\\le\\varepsilon\\le1$ 及 $j\\in\\{\\mathrm{full},\\mathrm{bits},\\mathrm{marked}\\}$ 满足\n\\begin{equation}\n c\\min\\{b^2,\\varepsilon\\}\\le V_j(b,\\varepsilon)\n \\le C\\min\\{b^2,\\varepsilon\\}.\n \\label{eq:main}\n\\end{equation}\n特别地，$V_j(b,0)=0$。常数可依赖维数、模型、$k$ 和 $b_{\\rm ref}$，\n但不依赖变化的 $b,\\varepsilon$。\n\\end{theorem}",
        "\\begin{remark}[维数、观测条件和时间范围]\n式\\eqref{eq:main}对任意固定 $n$ 给出同一阶数结构，其中的常数依赖具体维数与模型。\n可逆性保证下一时刻事件所对应的二次型在全部偏差方向上正定。\n若 $A$ 奇异，则对非零 $v\\in\\ker A$ 有 $v^\\top H(P)v=0$；\n沿该方向的当前偏差不改变下一时刻预测均值，因而不能由下一静默概率约束。\n这是单步事件感知全部偏差方向所需的结构条件。\n若使用部分测量 $y=Cx+v$，对应二次型含有 $CA$，\n仅凭 $(A,C)$ 可观不能保证单步二次型正定。\n因此，本节结论适用于全状态含噪测量及固定有限时刻；\n部分测量情形与时间一致界需要另行分析。\n有限时刻分析允许 $A$ 不稳定。\n\\end{remark}"
      ],
